<Window x:Class="DynamicWallpaperStudio.WebLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网页直播 · 独立页面" Width="1180" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="#111111" FontFamily="Segoe UI, Microsoft YaHei UI"
        Closed="WindowClosed">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="16,12,16,8">
      <TextBlock TextWrapping="Wrap" Foreground="#D0D5DD" FontSize="13"
                 Text="在这个独立页面里登录、开网页全屏、开关弹幕。调好后点「同步到桌面」，桌面会保持这一页，不必在壁纸上点鼠标。登录只存在资料库的 WebProfile，不读系统 Edge Cookie，不破解 DRM。"/>
      <TextBlock Text="腾讯视频等 Widevine 站点可能黑屏或提示换浏览器，这是站点限制。"
                 TextWrapping="Wrap" Foreground="#F79009" FontSize="12" Margin="0,6,0,0"/>
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="AddressBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" KeyDown="AddressKeyDown"/>
        <Button Grid.Column="1" Content="前往" Width="72" Margin="8,0,0,0" Click="GoClicked"/>
        <Button x:Name="SyncButton" Grid.Column="2" Content="同步到桌面" Width="120" Margin="8,0,0,0" Click="SyncClicked"/>
        <Button x:Name="RecallButton" Grid.Column="3" Content="取回编辑" Width="100" Margin="8,0,0,0" Click="RecallClicked"/>
      </Grid>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid x:Name="BrowserHost"/>
      <Border x:Name="SyncedOverlay" Background="#E6111111" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
          <TextBlock Text="已同步到桌面" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="#D0D5DD" FontSize="14" Margin="0,12,0,0"
                     Text="这一页正在桌面层播放，壁纸上不能点。要改全屏、弹幕或换房间，先点「取回编辑」，改完再同步。"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
