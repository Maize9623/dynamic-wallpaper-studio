<Application x:Class="DynamicWallpaperStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#F4F6FA" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Primary" Color="#0878F9" />
    <SolidColorBrush x:Key="SecondaryText" Color="#667085" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E4E7EC" />
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="Padding" Value="9,6" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
      <Setter Property="Padding" Value="7,5" />
    </Style>
  </Application.Resources>
</Application>
