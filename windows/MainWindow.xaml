<Window x:Class="DynamicWallpaperStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="动态壁纸工作室" Width="1120" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI, Microsoft YaHei UI" AllowDrop="True"
        PreviewDragEnter="WindowDragEnter" PreviewDragLeave="WindowDragLeave" PreviewDrop="WindowDrop" Closing="WindowClosing">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="205"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="310"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.RowSpan="2" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,0,1,0">
      <Grid Margin="16,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="4,0,0,22">
            <Border Width="38" Height="38" Background="#0878F9" CornerRadius="10">
              <Image Source="Assets/AppIcon.png" Margin="5"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="动态壁纸" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="工作室 · Windows" FontSize="11" Foreground="#667085"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="资料库" FontSize="11" Foreground="#98A2B3" Margin="7,0,0,5"/>
          <Button x:Name="AllButton" Content="▣  全部壁纸" HorizontalContentAlignment="Left" Click="ShowAll"/>
          <Button x:Name="FavoriteButton" Content="♡  收藏" HorizontalContentAlignment="Left" Click="ShowFavorites"/>
          <Button Content="◷  最近导入" HorizontalContentAlignment="Left" Click="ShowRecent"/>
          <TextBlock Text="显示器" FontSize="11" Foreground="#98A2B3" Margin="7,20,0,5"/>
          <StackPanel x:Name="DisplaysPanel"/>
          <Button Content="⚙  设置" HorizontalContentAlignment="Left" Margin="0,20,0,0" Click="ShowSettings"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#F7F9FC" CornerRadius="9" Padding="10,8">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="RunningDot" Width="8" Height="8" Fill="#12B76A" VerticalAlignment="Center"/>
            <TextBlock x:Name="RunningText" Text="动态壁纸正在运行" Foreground="#667085" FontSize="11" Margin="8,0,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="1" Grid.ColumnSpan="2" Background="#F9FAFB" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
      <Grid Margin="24,11,20,10">
        <TextBlock x:Name="PageTitle" Text="全部壁纸" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBox x:Name="SearchBox" Width="210" Height="36" VerticalContentAlignment="Center" ToolTip="搜索壁纸" TextChanged="SearchChanged"/>
          <Button x:Name="WallpaperPowerButton" Content="启动动态壁纸" Height="38" Margin="12,0,0,0" Click="WallpaperPowerClicked"/>
          <Button Content="＋ 导入视频" Height="38" Background="#0878F9" Foreground="White" FontWeight="SemiBold" Margin="12,0,0,0" Click="ImportClicked"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Grid.Row="1" Margin="20,18,14,18">
      <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border x:Name="EmptyPanel" Visibility="Collapsed" Padding="25" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="14">
            <StackPanel HorizontalAlignment="Center" Margin="20,45">
              <TextBlock Text="制作你的第一张动态壁纸" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="把视频拖到窗口，或从文件资源管理器选择" Foreground="#667085" Margin="0,8,0,16"/>
              <Button Content="导入视频" Background="#0878F9" Foreground="White" Width="105" Click="ImportClicked"/>
            </StackPanel>
          </Border>
          <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
        </StackPanel>
      </ScrollViewer>

      <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="White" CornerRadius="14" BorderBrush="#E4E7EC" BorderThickness="1" Padding="28">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
          <TextBlock Text="设置" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock Text="通用" FontSize="16" FontWeight="SemiBold" Margin="0,25,0,10"/>
          <CheckBox x:Name="StartWithWindowsBox" Content="登录 Windows 时自动在后台启动" Click="StartWithWindowsChanged"/>
          <TextBlock Text="开机后只显示动态壁纸和通知区域图标，不自动弹出管理窗口。" Foreground="#667085" Margin="22,6,0,0"/>
          <Separator Margin="0,22"/>
          <TextBlock Text="存储" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock x:Name="StorageText" FontWeight="SemiBold"/>
          <TextBlock x:Name="StoragePathText" Foreground="#667085" TextWrapping="Wrap" Margin="0,7,0,10"/>
          <Button Content="在文件资源管理器中打开" Width="180" HorizontalAlignment="Left" Click="RevealLibraryClicked"/>
          <Border Background="#ECFDF3" CornerRadius="9" Padding="13" Margin="0,24,0,0">
            <TextBlock Text="空间策略：保持原始分辨率时不复制视频；转换分辨率时只保存一份转换成品。应用不会在资料库里同时保存原片和转换版。"
                       Foreground="#067647" TextWrapping="Wrap"/>
          </Border>
          <TextBlock Text="隐私" FontSize="16" FontWeight="SemiBold" Margin="0,25,0,8"/>
          <TextBlock Text="视频只在本机处理，不上传，也不访问麦克风或摄像头。公开便携版仅在首次准备时，经你确认后联网下载并校验固定的 mpv/FFmpeg 组件；完成后播放和转换无需联网。" Foreground="#667085" TextWrapping="Wrap"/>
          <TextBlock Text="版本 1.0.5 · Windows 11 x64 · Preview" Foreground="#98A2B3" Margin="0,26,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="Inspector" Grid.Column="2" Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1,0,0,0" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
          <Border Height="265" Background="Black" CornerRadius="12" ClipToBounds="True">
            <Image x:Name="InspectorImage" Stretch="Uniform"/>
          </Border>
          <TextBox x:Name="NameBox" FontSize="18" FontWeight="SemiBold" Margin="0,15,0,5" LostFocus="NameChanged"/>
          <TextBlock x:Name="ActiveText" Text="未在桌面播放" Foreground="#12B76A" Margin="2,3,0,16"/>
          <TextBlock Text="应用到" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ComboBox x:Name="TargetDisplayBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
          <TextBlock Text="画面适配" FontWeight="SemiBold" Margin="0,16,0,6"/>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="InspectorFit" Content="完整显示" IsChecked="True" Margin="0,0,20,0"/>
            <RadioButton x:Name="InspectorFill" Content="填满屏幕"/>
          </StackPanel>
          <Button Content="设为动态壁纸" Background="#0878F9" Foreground="White" FontWeight="SemiBold" Margin="0,18,0,7" Click="ApplyClicked"/>
          <Button Content="导出便携壁纸包…" Click="ExportClicked"/>
          <Button Content="在文件资源管理器中显示" Click="RevealWallpaperClicked"/>
          <Border Background="#F7F9FC" CornerRadius="9" Padding="12" Margin="0,16,0,7">
            <TextBlock x:Name="MetadataText" Foreground="#475467" TextWrapping="Wrap" LineHeight="23"/>
          </Border>
          <Button Content="删除壁纸…" Foreground="#D92D20" Click="DeleteClicked"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border x:Name="DragOverlay" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Visibility="Collapsed"
            Background="#E60878F9" BorderBrush="#0878F9" BorderThickness="3" CornerRadius="16" Margin="16" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="↓" FontSize="54" Foreground="#0878F9" HorizontalAlignment="Center"/>
        <TextBlock Text="松开以导入视频" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="支持 MP4、MOV、M4V 和 .dwallpaper.zip" Foreground="#475467" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <Border x:Name="ProgressOverlay" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Visibility="Collapsed" Background="#99000000">
      <Border Background="White" CornerRadius="14" Padding="24" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="正在制作动态壁纸" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="ProgressText" Text="正在读取视频" Foreground="#667085" Margin="0,9,0,12"/>
          <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="1"/>
          <TextBlock Text="长视频会流式处理，不会整段装入内存。转换期间 CPU 占用会暂时升高。" Foreground="#667085" TextWrapping="Wrap" Margin="0,14,0,8"/>
          <Button x:Name="CancelProgressButton" Content="取消" Width="85" HorizontalAlignment="Right" Click="CancelProgressClicked"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
