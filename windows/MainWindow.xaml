<Window x:Class="DynamicWallpaperStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="摸鱼神器 · 动态壁纸工作室" Height="760" Width="1180"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#F4F6FA"
        FontFamily="Segoe UI, Microsoft YaHei UI" AllowDrop="True"
        DragEnter="WindowDragEnter" DragOver="WindowDragEnter" DragLeave="WindowDragLeave" Drop="WindowDrop"
        Closing="WindowClosing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="22,22,18,8">
            <TextBlock Text="摸鱼神器" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="桌面层播放 · 阅读 · 网页" Foreground="#667085" Margin="0,4,0,18"/>
            <Button Content="＋  导入视频 / 书" Click="ImportClicked"/>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Margin="16" Background="#F2F4F7" CornerRadius="14" Padding="14">
            <StackPanel>
              <TextBlock Text="当前状态" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Ellipse x:Name="RunningDot" Width="9" Height="9" Fill="#98A2B3" Margin="0,0,8,0"/>
                <TextBlock x:Name="RunningText" Text="动态壁纸已关闭" Foreground="#667085"/>
              </StackPanel>
              <Button x:Name="WallpaperPowerButton" Content="启动动态壁纸" Margin="0,12,0,0" Click="WallpaperPowerClicked"/>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,4">
              <TextBlock Text="资料库" Foreground="#98A2B3" Margin="10,4,0,6"/>
              <Button x:Name="AllButton" Content="▣  全部壁纸" HorizontalContentAlignment="Left" Click="ShowAll"/>
              <Button x:Name="FavoriteButton" Content="♡  收藏" HorizontalContentAlignment="Left" Click="ShowFavorites"/>
              <Button Content="◷  最近导入" HorizontalContentAlignment="Left" Click="ShowRecent"/>
              <TextBlock Text="摸鱼台" Foreground="#98A2B3" Margin="10,16,0,6"/>
              <Button Content="▶  播放台" HorizontalContentAlignment="Left" Click="ShowPlayer"/>
              <Button Content="文  电子书" HorizontalContentAlignment="Left" Click="ShowReader"/>
              <Button Content="◉  网页直播" HorizontalContentAlignment="Left" Click="ShowWeb"/>
              <Button Content="⌂  客厅伪装" HorizontalContentAlignment="Left" Click="ShowScene"/>
              <TextBlock Text="显示器" Foreground="#98A2B3" Margin="10,16,0,6"/>
              <StackPanel x:Name="DisplaysPanel"/>
              <Button Content="⚙  设置" HorizontalContentAlignment="Left" Margin="0,16,0,0" Click="ShowSettings"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="28,22,18,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBox x:Name="SearchBox" Width="230" TextChanged="SearchChanged"/>
          </StackPanel>
          <TextBlock x:Name="PageTitle" Text="全部壁纸" FontSize="30" FontWeight="SemiBold"/>
        </DockPanel>

        <ScrollViewer x:Name="LibraryScroll" Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <WrapPanel x:Name="CardsPanel"/>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" Margin="0,80,0,0" Visibility="Collapsed">
              <TextBlock Text="还没有壁纸" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="导入本地视频，或把文件拖到窗口里。默认只引用原文件。" Foreground="#667085" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StudioScroll" Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel>
            <Border x:Name="PlayerPanel" Background="White" CornerRadius="16" BorderBrush="#E4E7EC" BorderThickness="1" Padding="22" Margin="0,0,0,16" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="连续播放" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="排好顺序后按列表播完即停，不会整表循环。单条壁纸循环请关闭「列表播放」。" TextWrapping="Wrap" Foreground="#667085" Margin="0,6,0,12"/>
                <CheckBox x:Name="PlaylistModeBox" Content="列表播放（关闭则为当前壁纸循环）" Click="PlaylistModeChanged"/>
                <ListBox x:Name="PlaylistBox" Height="220" Margin="0,12,0,0" DisplayMemberPath="Name"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="加入当前选中" Width="120" Click="AddSelectedToPlaylist"/>
                  <Button Content="上移" Width="72" Margin="8,0,0,0" Click="MovePlaylistUp"/>
                  <Button Content="下移" Width="72" Margin="8,0,0,0" Click="MovePlaylistDown"/>
                  <Button Content="移除" Width="72" Margin="8,0,0,0" Click="RemovePlaylistItem"/>
                  <Button Content="从这里播放" Width="110" Margin="8,0,0,0" Click="PlayPlaylistHere"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="ReaderPanel" Background="White" CornerRadius="16" BorderBrush="#E4E7EC" BorderThickness="1" Padding="22" Margin="0,0,0,16" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="电子书" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="本地 TXT（UTF-8 / GB18030）和 PDF。阅读位置记在资料库，不改原文件，也不会上传。" TextWrapping="Wrap" Foreground="#667085" Margin="0,6,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="导入 TXT / PDF" Width="140" Click="ImportBookClicked"/>
                  <Button Content="打开到桌面" Width="120" Margin="8,0,0,0" Click="OpenBookClicked"/>
                  <Button Content="删除记录" Width="100" Margin="8,0,0,0" Click="DeleteBookClicked"/>
                </StackPanel>
                <ListBox x:Name="BooksBox" Height="180" Margin="0,12,0,0" DisplayMemberPath="Name"/>
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="上一页" Width="88" Click="ReaderPrev"/>
                  <Button Content="下一页" Width="88" Margin="8,0,0,0" Click="ReaderNext"/>
                  <Button Content="字号 −" Width="72" Margin="16,0,0,0" Click="ReaderSmaller"/>
                  <Button Content="字号 ＋" Width="72" Margin="8,0,0,0" Click="ReaderLarger"/>
                  <Button Content="浅色" Width="72" Margin="16,0,0,0" Click="ReaderLight"/>
                  <Button Content="深色" Width="72" Margin="8,0,0,0" Click="ReaderDark"/>
                </WrapPanel>
                <CheckBox x:Name="AutoTurnBox" Content="自动翻页" Margin="0,14,0,0" Click="AutoTurnChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="间隔（秒）" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox x:Name="AutoTurnSecondsBox" Width="72" Text="8" LostFocus="AutoTurnSecondsChanged"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="WebPanel" Background="White" CornerRadius="16" BorderBrush="#E4E7EC" BorderThickness="1" Padding="22" Margin="0,0,0,16" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="网页 / 直播" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="#667085" Margin="0,6,0,12"
                           Text="先打开独立页面：登录、网页全屏、弹幕都在那里设。设好后点「同步到桌面」，壁纸只保持这一页，不能在桌面上点。播放条的静音对直播有效；B 站 / 腾讯等点播还可以用播放和倍速。配置在资料库 WebProfile，不读系统 Edge Cookie，不破解 DRM。"/>
                <TextBox x:Name="WebUrlBox" Margin="0,0,0,10"/>
                <Button Content="打开独立页面" Width="140" HorizontalAlignment="Left" Click="OpenWebStudioClicked"/>
              </StackPanel>
            </Border>

            <Border x:Name="ScenePanel" Background="White" CornerRadius="16" BorderBrush="#E4E7EC" BorderThickness="1" Padding="22" Margin="0,0,0,16" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="客厅电视伪装" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="#667085" Margin="0,6,0,12"
                           Text="勾选后点「应用」才会切换客厅样板。视频、电子书或网页只出现在电视屏幕里。关电视会停声、停画面并冻结进度，背景留下。"/>
                <StackPanel Orientation="Horizontal">
                  <CheckBox x:Name="SceneBox" Content="启用客厅伪装" VerticalAlignment="Center"/>
                  <Button Content="应用" Width="88" Margin="12,0,0,0" Click="ApplySceneClicked"/>
                </StackPanel>
                <Border Margin="0,12,0,0" Height="150" CornerRadius="10" ClipToBounds="True" Background="Black">
                  <Image x:Name="ScenePreview" Stretch="UniformToFill"/>
                </Border>
                <CheckBox x:Name="TelevisionOffBox" Content="关电视（冻结进度，只留背景或桌面）" Margin="0,12,0,0" Click="TelevisionOffChanged"/>
                <Button Content="老板键：立刻隐藏 / 恢复" Width="220" HorizontalAlignment="Left" Margin="0,14,0,0" Click="BossClicked"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
          <StackPanel>
            <Border Background="White" CornerRadius="16" BorderBrush="#E4E7EC" BorderThickness="1" Padding="22">
              <StackPanel>
                <TextBlock Text="开机启动" FontWeight="SemiBold"/>
                <CheckBox x:Name="StartWithWindowsBox" Content="登录 Windows 后自动在后台启动" Margin="0,10,0,0" Click="StartWithWindowsChanged"/>
                <TextBlock Text="如果以后移动了整个程序文件夹，请关闭后再打开一次该选项，以更新启动路径。" TextWrapping="Wrap" Foreground="#667085" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="16" BorderBrush="#E4E7EC" BorderThickness="1" Padding="22" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="资料库位置" FontWeight="SemiBold"/>
                <TextBlock x:Name="StorageText" Margin="0,10,0,0"/>
                <TextBlock x:Name="StoragePathText" Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="默认用程序旁边的 Data 文件夹。可以改到任意磁盘，导入默认只引用原文件，不会强制写到 C 盘。" TextWrapping="Wrap" Foreground="#667085" Margin="0,8,0,0"/>
                <CheckBox x:Name="CopyImportBox" Content="导入时默认复制到资料库（仍可在导入窗口改）" Margin="0,10,0,0" Click="CopyImportChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="打开资料库文件夹" Width="150" Click="RevealLibraryClicked"/>
                  <Button Content="选择资料库文件夹" Width="150" Margin="10,0,0,0" Click="ChangeLibraryClicked"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="16" BorderBrush="#E4E7EC" BorderThickness="1" Padding="22" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="老板键" FontWeight="SemiBold"/>
                <CheckBox x:Name="BossHotkeyBox" Content="启用全局老板键" Margin="0,10,0,0" Click="BossHotkeyChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBox x:Name="BossHotkeyText" Width="160" Text="Ctrl+Alt+B"/>
                  <Button Content="应用" Width="72" Margin="8,0,0,0" Click="BossHotkeyChanged"/>
                </StackPanel>
                <TextBlock Text="这是展示切换，不是对抗公司监控。隐藏状态优先于睡眠唤醒后的自动恢复。" TextWrapping="Wrap" Foreground="#667085" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border x:Name="Inspector" Grid.Column="2" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1,0,0,0" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="18">
            <ComboBox x:Name="TargetDisplayBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <Button Content="设为动态壁纸" Background="#0878F9" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,0" Click="ApplyClicked"/>
            <Button Content="加入播放列表" Margin="0,8,0,0" Click="AddSelectedToPlaylist"/>
            <Button Content="在文件夹中显示" Margin="0,8,0,0" Click="RevealWallpaperClicked"/>
            <Button Content="导出壁纸包" Margin="0,8,0,0" Click="ExportClicked"/>
            <Button Content="删除" Margin="0,8,0,0" Click="DeleteClicked"/>
          </StackPanel>
          <ScrollViewer>
            <StackPanel Margin="18,22,18,0">
              <Border Height="168" Background="Black" CornerRadius="12" ClipToBounds="True">
                <Image x:Name="InspectorImage" Stretch="Uniform"/>
              </Border>
              <TextBox x:Name="NameBox" Margin="0,14,0,0" LostFocus="NameChanged"/>
              <TextBlock x:Name="ActiveText" Margin="0,8,0,0" Foreground="#12B76A"/>
              <TextBlock x:Name="AudioHintText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#B54708"/>
              <TextBlock Text="画面适配" FontWeight="SemiBold" Margin="0,16,0,8"/>
              <RadioButton x:Name="InspectorFit" Content="完整显示" GroupName="InspectorAspect"/>
              <RadioButton x:Name="InspectorFill" Content="填满屏幕" GroupName="InspectorAspect" Margin="0,6,0,0"/>
              <TextBlock x:Name="MetadataText" Foreground="#667085" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="#111827" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="HudPrevButton" Content="⏮" Width="40" Click="HudPrev"/>
          <Button x:Name="HudPlayButton" Content="▶" Width="44" Margin="6,0" Click="HudPlay"/>
          <Button x:Name="HudNextButton" Content="⏭" Width="40" Click="HudNext"/>
          <Button x:Name="HudMuteButton" Content="🔇" Width="44" Margin="10,0,0,0" Click="HudMute"/>
        </StackPanel>
        <Grid Grid.Column="1" Margin="16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="HudTimeText" Text="0:00 / 0:00" Foreground="#D0D5DD" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Slider x:Name="HudSeek" Grid.Column="1" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center"
                  PreviewMouseLeftButtonDown="HudSeekStart" PreviewMouseLeftButtonUp="HudSeekEnd"/>
          <ComboBox x:Name="HudSpeed" Grid.Column="2" Width="72" Margin="10,0,0,0" SelectionChanged="HudSpeedChanged">
            <ComboBoxItem Content="1x" Tag="1" IsSelected="True"/>
            <ComboBoxItem Content="1.25x" Tag="1.25"/>
            <ComboBoxItem Content="1.5x" Tag="1.5"/>
            <ComboBoxItem Content="2x" Tag="2"/>
          </ComboBox>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Slider x:Name="HudVolume" Width="110" Minimum="0" Maximum="100" Value="70" VerticalAlignment="Center" ValueChanged="HudVolumeChanged"/>
          <Button Content="关电视" Width="72" Margin="10,0,0,0" Click="TelevisionOffChanged"/>
          <Button Content="老板键" Width="72" Margin="6,0,0,0" Click="BossClicked"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="ProgressOverlay" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed">
      <Border Width="420" Background="White" CornerRadius="16" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="ProgressText" Text="正在处理" FontSize="18" FontWeight="SemiBold"/>
          <ProgressBar x:Name="ProgressBar" Height="10" Margin="0,16,0,0"/>
          <Button x:Name="CancelProgressButton" Content="取消" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0" Click="CancelProgressClicked"/>
        </StackPanel>
      </Border>
    </Border>
    <Border x:Name="DragOverlay" Grid.RowSpan="2" Background="#660878F9" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock Text="放开即可导入视频、TXT 或 PDF" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </Grid>
</Window>
